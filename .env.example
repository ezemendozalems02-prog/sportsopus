# Supabase — obligatorio, ya no hay modo mock (ver README).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Connection string directa a Postgres, solo para correr migraciones
# (scripts/run-migrations.mjs). Si tu proyecto de Supabase solo tiene salida
# IPv6 disponible desde donde corrés esto, usá la URL del "Transaction
# pooler" del dashboard (Project Settings → Database) en vez de la conexión
# directa — mismo formato, host/puerto distintos.
SUPABASE_DB_URL=

# Mercado Pago — access token de la app de Suscripciones (src/lib/mercadopago.ts).
# Requerido para que /admin/plan pueda vincular el checkout real de MP y para
# que el webhook en src/app/api/mercadopago/webhook mantenga el estado de la
# suscripción al día. Court/product checkout (reservas, ventas) sigue
# simulado por separado y no usa esta variable.
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_PUBLIC_KEY=

# Superadmin login (platform owner panel, /superadmin) — leave unset to use
# the local defaults (admin@sportcontrol.app / super1234), documented in
# README. Set real values before deploying anywhere public.
SUPERADMIN_EMAIL=
SUPERADMIN_PASSWORD=
